# AI 基本面研究员 环境配置
# 复制此文件为 .env 并填入实际值

# ===== DeepSeek（推荐，OpenAI 兼容） =====
AFR_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
AFR_AI_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 其他模型（可选） =====
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# AFR_AI_MODEL=gpt-4o-mini
# CLAUDE_API_KEY=sk-ant-xxx

# ===== 后端 =====
HOST=0.0.0.0
PORT=8800
# 兼容旧变量名
AFR_HOST=0.0.0.0
AFR_PORT=8800

# ===== 前端 =====
NEXT_PUBLIC_API_URL=http://localhost:8800
# NEXT_PUBLIC_AFR_ENABLE_BACKTEST=true
# NEXT_PUBLIC_AFR_ENABLE_PORTFOLIO=true
# NEXT_PUBLIC_AFR_ENABLE_FACTOR_LAB=true

# ===== 爬虫 =====
CRAWL_DELAY_SEC=1.5
MAX_RETRIES=3
AFR_HTTP_TIMEOUT=15
AFR_NO_PROXY_HOSTS=eastmoney.com,sina.com.cn,gtimg.cn

# ===== 安全（生产建议开启） =====
# AFR_API_KEY=your-secret-key
# AFR_API_KEY_REQUIRED=true
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 实验模块开关（true/false） =====
# AFR_ENABLE_BACKTEST=true
# AFR_ENABLE_PORTFOLIO=true
# AFR_ENABLE_FACTOR_LAB=true
# AFR_ENABLE_ADVANCED=true
# AFR_ENABLE_PREMIUM=true
# AFR_ENABLE_RAG=true

# ===== 因子评分 =====
AFR_FACTOR_BENCHMARK=industry

# ===== 日志 =====
AFR_LOG_LEVEL=INFO

# AI 基本面研究员 环境配置
# 复制此文件为 .env 并填入实际值

# ===== DeepSeek（推荐，OpenAI 兼容） =====
AFR_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
AFR_AI_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 其他模型（可选） =====
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# AFR_AI_MODEL=gpt-4o-mini
# CLAUDE_API_KEY=sk-ant-xxx

# ===== 后端 =====
HOST=0.0.0.0
PORT=8800
# 兼容旧变量名
AFR_HOST=0.0.0.0
AFR_PORT=8800

# ===== 前端 =====
NEXT_PUBLIC_API_URL=http://localhost:8800
# NEXT_PUBLIC_AFR_ENABLE_BACKTEST=true
# NEXT_PUBLIC_AFR_ENABLE_PORTFOLIO=true
# NEXT_PUBLIC_AFR_ENABLE_FACTOR_LAB=true

# ===== 爬虫 =====
CRAWL_DELAY_SEC=1.5
MAX_RETRIES=3
AFR_HTTP_TIMEOUT=15
AFR_NO_PROXY_HOSTS=eastmoney.com,sina.com.cn,gtimg.cn

# ===== 安全（生产建议开启） =====
# AFR_API_KEY=your-secret-key
# AFR_API_KEY_REQUIRED=true
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 实验模块开关（true/false） =====
# AFR_ENABLE_BACKTEST=true
# AFR_ENABLE_PORTFOLIO=true
# AFR_ENABLE_FACTOR_LAB=true
# AFR_ENABLE_ADVANCED=true
# AFR_ENABLE_PREMIUM=true
# AFR_ENABLE_RAG=true

# ===== 因子评分 =====
AFR_FACTOR_BENCHMARK=industry

# ===== 市场状态 L1 / L2 / L3（Regime Pipeline） =====
# 主指数（四格 bucket 以 CSI800 为准）
# AFR_REGIME_PRIMARY_INDEX=sh000906
# AFR_REGIME_INDEX_CSI300=sh000300
# AFR_REGIME_INDEX_CSI800=sh000906

# L1 分类阈值
# AFR_REGIME_VOL_HIGH=0.17
# AFR_REGIME_TREND_RET20_STRONG=0.08
# AFR_REGIME_TREND_PRIORITY_OVER_VOL=true

# L1 持续性确认（不对称：上涨慢、下跌快）
# AFR_REGIME_ASYMMETRIC_PERSISTENCE=true
# AFR_REGIME_UP_CONFIRM_DAYS=5
# AFR_REGIME_DOWN_CONFIRM_DAYS=2
# AFR_REGIME_VOL_CONFIRM_DAYS=3
# AFR_REGIME_OSC_CONFIRM_DAYS=3
# AFR_REGIME_PERSISTENCE_DAYS=5

# L2 策略×状态矩阵
# AFR_MATRIX_LOOKBACK_DAYS=730
# AFR_MATRIX_BACKTEST_DAYS=500
# AFR_MATRIX_MIN_SAMPLES=10

# L3 推荐监控
# AFR_REC_OUTCOME_HORIZONS=5,20

# 调度：日终是否刷新 L2 矩阵（默认 false，周度 true）
# AFR_REGIME_DAILY_REFRESH_MATRIX=false
# AFR_REGIME_WEEKLY_REFRESH_MATRIX=true

# ===== 日志 =====
AFR_LOG_LEVEL=INFO

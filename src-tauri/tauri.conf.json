{
  "productName": "AI Fundamental Researcher",
  "version": "0.1.0",
  "identifier": "com.afr.app",
  "build": {
    "frontendDist": "assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Fundamental Researcher",
        "width": 1440,
        "height": 900,
        "url": "loading.html",
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
